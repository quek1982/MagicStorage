		Keybinds.PrintItemData.DisplayName: Imprimer les données de l'élément

		Configs: {
			MagicStorageConfig: {
				DisplayName: Configuration de stockage magique

				quickStackDepositMode: {
					Label: "[i: poitrine] Mode de dépôt de pile rapide"
					Tooltip: Activer la pile rapide avec le contrôle (CTRL) pressé, désactiver la pile rapide avec le contrôle (CTRL) libéré
				}

				useConfigFilter: {
					Label: "[i: magicstorage / config_repipeFilterAvailable] [i: magicstorage / config_repipeFilterall] Utilisez le filtre par défaut"
					Tooltip: Activer d'utiliser le filtre ci-dessous, désactiver pour se souvenir du dernier filtre sélectionné dans le jeu (le filtre est toujours utilisé en premier ouvert après la charge du mod)
				}

				showAllRecipes: {
					Label: "[I: MagicStorage / Config_RecipeFilterAvailable] [I: MagicStorage / Config_RecipeFilterall] Filtre de recette par défaut"
					Tooltip: Activer la valeur par défaut de toutes les recettes, désactiver les recettes disponibles par défaut
				}

				useOldCraftMenu: {
					Label: "[I: Workbench] Utilisez de vieux boutons d'artisanat"
					Tooltip: Activer l'utilisation de l'interface utilisateur plus ancienne pour la fabrication dans l'interface graphique de fabrication
				}

				recipeBlacklist: {
					Label: Recette liste blanche / liste noire
					Tooltip: Activer l'autorisation de recettes de liste blanche et de liste noire dans l'interface graphique de l'artisanat
				}

				globalRecipeBlacklist: {
					Label: Liste noire de recette mondiale
					Tooltip: Cliquez avec le changement de gauche Ctrl + gauche pour ajouter / supprimer la liste noire
				}

				clearHistory: {
					Label: "[i: livre] Historique des recettes claires"
					Tooltip: Permettre de nettoyer l'histoire de la recette dans l'interface graphique de l'artisanat lors de l'ouverture
				}

				recursionCraftingDepth: {
					Label: Profondeur de récursivité de la recette
					Tooltip:
						'''
						À quelle profondeur la récursivité va pour l'élaboration de recettes dans l'interface utilisateur de fabrication.
						Réglé sur 0 pour désactiver cette fonctionnalité.
						Réglé sur -1 pour une profondeur infinie
						'''
				}

				glowNewItems: {
					Label: "[I: MagicStorage / Config_GlowItemlowing] [I: MagicStorage / Config_GlowItemNOTLINGLING] Affichez de nouveaux éléments / recettes"
					Tooltip: Bascule si les nouveaux articles dans le stockage brillent pour indiquer qu'ils sont nouveaux
				}

				clearSearchText: {
					Label: Effacer le texte de recherche
					Tooltip: Activer d'effacer le texte de recherche lors de l'ouverture de l'interface utilisateur
				}

				searchBarRefreshOnKey: {
					Label: Recherche de rafraîchissement de la barre sur la touche Appuyez
					Tooltip: Activer la barre de recherche dans le stockage et l'élaboration de GUIS Rafraîchir l'interface graphique sur chaque touche pressée, désactiver pour que le rafraîchissement se produise uniquement lorsque la barre de recherche est désélectionnée
				}

				uiFavorites: {
					Label: "[I: Fallenstar] Bouton Filtre Favoris"
					Tooltip: Activer l'autorisation des articles / recettes favorisés dans l'interface graphique de fabrication
				}

				extraFilterIcons: {
					Label: "[I: COG] Affichez les icônes de tri supplémentaires"
					Tooltip: Activer d'avoir les options de tri supplémentaires disponibles dans la disposition du bouton Legacy
				}

				buttonLayout: {
					Label: Tri / filtrage de la disposition des bouton
					Tooltip:
						'''
						Héritage:
						    Disposition de V0.5.6.5 et des versions précédentes.
						    Les pages de tri et de filtrage sont désactivées.
						Page:
						    Options de tri et de filtrage déplacées vers les pages de tri et de filtrage.
						Configurable:
						    Sélectionnez les options de tri et de filtrage à partir des pages de tri et de filtrage apparaissent dans la page d'interface utilisateur principale.
						Legacy + configurable:
						    La mise en page de V0.5.6.5 et des versions précédentes si "Afficher les icônes de tri supplémentaires" était désactivée.
						    Une icône de vitesse supplémentaire est ajoutée qui, lorsqu'elle est cliquée, ouvre un panneau contenant toutes les autres options.
						    Les pages de tri et de filtrage sont désactivées.
						Legacy + Paged:
						    La mise en page de V0.5.6.5 et des versions précédentes si "Afficher les icônes de tri supplémentaires" était désactivée.
						    Des icônes supplémentaires sont dans les pages de tri et de filtrage.
						Dérouler:
						    Deux menus déroulants sont ajoutés à la page d'interface utilisateur principale pour sélectionner l'option de tri et de filtrage souhaitée.
						    Les pages de tri et de filtrage sont désactivées.
						'''
				}

				itemDataDebug: {
					Label: "[I: IronPickaxe] Informations sur le débogage des articles"
					Tooltip: Activer de fabriquer des éléments dans l'interface graphique de stockage Affichez s'ils ont des données globales et permettent aux données "Imprimer les données" de clés pour imprimer des données
				}

				canMovePanels: {
					Label: Mouvement du panneau d'interface utilisateur
					Tooltip: Désactiver pour empêcher le déplacement et le redimensionnement des panneaux d'interface utilisateur
				}

				automatonRemembers: {
					Label: Automaton se souvient de la dernière aide à l'aide
					Tooltip: L'automate se souviendra de l'aide à l'assistance à afficher pour l'utilisateur et à afficher cette pointe d'aide lorsqu'il est interagi.
				}

				globalShimmerItemBlacklist: {
					Label: Article global scintillant noire liste
					Tooltip: Cliquez avec le changement de gauche Ctrl + gauche pour ajouter / supprimer la liste noire
				}
			}

			ButtonConfigurationMode: {
				Tooltip: ""
				Legacy.Label: Héritage
				ModernPaged.Label: Pagin
				ModernConfigurable.Label: Configurable
				LegacyWithGear.Label: Héritage + configurable
				LegacyBasicWithPaged.Label: Legacy + Paged
				ModernDropdown.Label: Dérouler
			}

			MagicStorageServerConfig: {
				DisplayName: Configuration du serveur de stockage magique

				allowAutomatonToMoveIn: {
					Label: Logement automatique
					Tooltip: Permettre à l'automate de pouvoir passer dans le logement
				}

				auditLog: {
					Label: Journal d'audit du serveur
					Tooltip: Permettre de faire en sorte que les interactions du client avec n'importe quel système de stockage soient signalées à un journal d'audit
				}
			}

			MagicStorageBetaConfig.DisplayName: "{$Mods.MagicStorage.Config.BetaLabel}"
		}
