		Projectiles.BiomeGlobeThrown.DisplayName: Biome Globe

		NPCs: {
			Golem: {
				DisplayName: Automate

				TownNPCMood: {
					Content: Les systèmes sont opérationnels.
					NoHome: L'exposition aux éléments accélère la rouille, demandant la maison à la maison.
					LoveSpace: Des accords de vie acceptables ont été acquis.
					FarFromHome: Cette unité doit retourner chez elle pour recharger son condensateur Bluemagic dès que possible.
					DislikeCrowded: Trop d'individus ont détecté à proximité.
					HateCrowded: Cette unité préfère être plus solitaire.
					LikeBiome: "{BiomeName} s'harmonise avec Bluemagic."
					LoveBiome: "{BiomeName} mène parfaitement Bluemagic."
					DislikeBiome: Bluemagic a abaissé l'efficacité dans {BiomeName}.
					HateBiome: Bluemagic devient instable dans {BiomeName}.
					LikeNPC: "{NPCName} apprécie la puissance de Bluemagic."
					LoveNPC: Cette unité ne s'en soucierait pas si {NPCName} examinait ses engrenages.
					DislikeNPC: Cette unité regrette en mentionnant Bluemagic à {NPCName}.
					HateNPC: "{NPCName} doit apprendre que Bluemagic ne peut pas être utilisé à but lucratif."
					LikeNPC_Princess: "{NPCName} est le meilleur ami de mon créateur."
					Princess_LovesNPC: "{NPCName} est une machine si intéressante, comment se déplace-t-elle?"
				}

				# Census support
				Census.SpawnCondition: '''"{$Mods.MagicStorage.Configs.MagicStorageServerConfig.allowAutomatonToMoveIn.Label}" Config dans le "{$Mods.MagicStorage.Configs.MagicStorageServerConfig.DisplayName}" réglé sur ON'''
			}
		}

