			FillWithGarbage: Remplissez des éléments aléatoires
			SellDuplicatesHeader: Vendre des doublons
			SellDuplicatesButton: Vendre
			SetAStorageName: Entrez un nom ici ...
			NameWasCleared: Le nom a été effacé
			NameWasSetTo: Le nom a été défini sur: {0}

			ItemDeletionMode: {
				Label: Mode de suppression des éléments
				Enabled: Le mode de suppression de l'élément est maintenant [c / 00FF00: activé].  Double-cliquez sur un élément pour le supprimer.
				Disabled: Le mode de suppression des éléments est maintenant [c / ff0000: désactivé].
			}

			SellDuplicatesMenu: {
				Label: Mode de vente d'articles
				Enabled: Le mode de vente d'articles est maintenant [c / 00FF00: activé].  Cliquez sur les articles pour les marquer comme des articles à vendre.
				Disabled: Le mode de vente d'articles est maintenant [C / FF0000: désactivé].
				NoPrefix: Vendre des doublons sans préfixe
				KeepMostValue: Garder le plus cher
				KeepLeastValue: Garder le moins cher

				SoldItemsReport: {
					GotCoins: "{0} / {1} Les éléments ont été vendus pour {2}"
