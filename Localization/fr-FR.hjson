			PortableAccessPreHM: {
				DisplayName: Accès de stockage à distance portable de base
				Tooltip:
					'''
					<right> Cœur de Stockage pour stocker l'emplacement
					Actuellement, aucun emplacement n'est défini
					Utilisez l'article pour accéder à votre stockage
					Le cœur lié doit être au maximum de 100 'de n'importe quel pylône valide pour gagner une portée étendue sur chaque pylône
					Le joueur doit être au maximum de 1000 'du cœur ou du pylône lié pour accéder au stockage
					'''
			}

			PortableAccessHM: {
				DisplayName: Accès avancé de stockage à distance portable
