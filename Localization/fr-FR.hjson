# I recommend using the hjson key to translate all future text additions
# Also add them into other hjsons, but mark them with "//", and wait for translators to translate the text
# -Crapsky233

Mods: {
	MagicStorage: {
		Items: {
			BiomeGlobe: {
				DisplayName: Globe du biome
				Tooltip:
					'''
					'Le pouvoir du monde est à portée de main'
					Permet de fabriquer des recettes qui nécessitent le biome toundra, l'éctobrume, l'autel démoniaque/carmin et l'eau/lave/miel
					Peut être dans l'inventaire ou dans l'emplacement de station d'une interface d'artisanat
					Lorsqu'elles sont dans l'inventaire, les guimauves peuvent être cuites sans avoir besoin de se tenir près d'un feu de camp
					Permet de fabriquer des guimauves cuites dans l'interface d'artisanat
					Agit comme un ballon de plage lorsqu'il est lancé
					'''
			}

			CraftingAccess: {
				DisplayName: Interface de stockage d'artisanat
				Tooltip: Permet l'artisanat avec les éléments d'un système de stockage
			}

			CreativeStorageUnit: {
				DisplayName: Unité de stockage Créatif
				Tooltip:
					'''
					Stocke un montant illimité de chaque type d'article.
					Ne compte pas pour les limites de stockage lors d'un système de stockage.
					'''
			}

			Locator: {
				DisplayName: Localisateur
				Tooltip:
					'''
					<right> Cœur de Stockage pour stocker l'emplacement
					<right> Accès Stockage Distant pour le définir
					'''
			}

			LocatorDisk: {
				DisplayName: Disque Localisateur
				Tooltip:
					'''
					<right> Cœur de Stockage pour stocker l'emplacement
					<right> Accès au stockage éloigné pour le définir
					N'est pas détruit à l'usage
					'''
			}

			PortableAccess: {
				DisplayName: Accès portable ultime au stockage éloigné
				Tooltip:
					'''
					Cour de Stockage pour stocker lemplacement
					Actuellement aucun emplacement n'est défini
					Utilisez l'objet pour accéder à votre stockage
					Dispose d'une portée d'accès illimitée
					'''
			}

			PortableCraftingAccess: {
				DisplayName: Accès portable ultime à l'artisanat éloigné
				Tooltip:
					'''
					<right> Interface de stockage d'artisanat pour stocker l'emplacement
					Actuellement, aucun emplacement n'est défini
					Utilisez l'objet pour accéder à votre artisanat
					Dispose d'une portée d'accès illimitée
					'''
			}

			RadiantJewel: {
				DisplayName: Bijou rayonnant
				Tooltip: "'Brille avec une lumière éblouissante'"
			}

			RemoteAccess: {
				DisplayName: Accès au stockage éloigné
				Tooltip:
					'''
					Permet l'accès à distance d'un cœur de stockage
					Agit comme un "centre de stockage" pour des composants comme l'interface d'artisanat
					'''
			}

			ShadowDiamond: {
				DisplayName: Diamant de l'ombre
				Tooltip: Des traces de lumière persistent encore à l'intérieur
			}

			SnowBiomeEmulator: {
				DisplayName: Groche de snowglobe cassé
				Tooltip: Permet l'interface d'artisanat de stockage pour élaborer des recettes de biome de neige
			}

			StorageAccess: {
				DisplayName: Accès au stockage
				Tooltip: Agit comme un autre point d'accès pour afficher les éléments stockés dans un système de stockage
			}

			StorageComponent: {
				DisplayName: Composant de stockage
				Tooltip: L'article de base pour créer tout composant de stockage magique
			}

			StorageConnector: {
				DisplayName: Connecteur de stockage
				Tooltip: Agit comme un pont pour la connexion des composants des composants de stockage magiques
			}

			StorageDeactivator: {
				DisplayName: Baguette d'unité de stockage
				Tooltip:
					'''
					Active / désactive une unité de stockage
					Les unités de stockage désactivé tenteront de transférer leurs articles vers des unités de stockage activées dans un système de stockage
					'''
			}

			StorageHeart: {
